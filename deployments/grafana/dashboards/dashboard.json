{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Golden-signal dashboard for the FHIR Privacy Proxy. Panels are driven by the fhir_proxy_* metrics registered in internal/metrics/metrics.go. The Prometheus datasource is provisioned alongside this file.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "fhir-privacy-proxy",
  "title": "FHIR Privacy Proxy",
  "tags": ["fhir", "privacy", "observability"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by method and status",
      "description": "sum(rate(fhir_proxy_requests_total)) grouped by HTTP method and status code. First thing you check when a user says 'FHIR calls are failing'.",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20, "stacking": {"mode": "normal"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (method, status) (rate(fhir_proxy_requests_total[1m]))",
          "legendFormat": "{{method}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "description": "fhir_proxy_active_connections gauge. Useful as a sanity check when request rate drops to zero.",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "fhir_proxy_active_connections"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Break-glass events (5m)",
      "description": "Emergency overrides in the last 5 minutes. Should normally be zero; a spike here warrants an immediate audit.",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(fhir_proxy_break_glass_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Auth failures (5m)",
      "description": "Total authentication failures summed across every reason in the last 5 minutes.",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 100}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(fhir_proxy_auth_failures_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request latency (p50/p95/p99)",
      "description": "End-to-end proxy latency from fhir_proxy_request_duration_seconds. Tracks everything the proxy is responsible for — auth, rate-limit, OPA, risk score, upstream, redaction.",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(fhir_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(fhir_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(fhir_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upstream FHIR latency (p50/p95/p99)",
      "description": "fhir_proxy_upstream_duration_seconds — just the HAPI FHIR round-trip. Diffing this against request latency localises slow-down to the proxy's own middleware.",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum by (le) (rate(fhir_proxy_upstream_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(fhir_proxy_upstream_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(fhir_proxy_upstream_duration_seconds_bucket[5m])))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Policy outcome breakdown",
      "description": "fhir_proxy_policy_outcome_total by {outcome, reason}. 'reason' is OPA's free-form string (role_denied, risk_too_high, tenant_mismatch, …) so new values appear here automatically.",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (outcome, reason) (increase(fhir_proxy_policy_outcome_total[5m]))",
          "legendFormat": "{{outcome}} / {{reason}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Risk score distribution",
      "description": "fhir_proxy_risk_scores_total by label. 'normal' should dominate; a sudden rise in 'suspicious' or 'anomalous' is the first signal to go look at /feedback.",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "normal"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "suspicious"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "anomalous"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (label) (increase(fhir_proxy_risk_scores_total[5m]))",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Break-glass events by tenant",
      "description": "Per-tenant rate of fhir_proxy_break_glass_total. Even one event per hour is worth a Slack ping in most deployments.",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "fillOpacity": 60}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tenant_id) (increase(fhir_proxy_break_glass_total[1m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Auth failures by reason",
      "description": "fhir_proxy_auth_failures_total. 'reason' covers invalid_token, expired_token, missing_scope, tenant_mismatch, etc. — quick diagnostic when users can't get in.",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 20, "stacking": {"mode": "normal"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (reason) (rate(fhir_proxy_auth_failures_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
