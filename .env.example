# Azure Audit Logging
AZURE_STORAGE_ACCOUNT=fhiraudit
AZURE_STORAGE_KEY=<your-azure-storage-key>
AZURE_AUDIT_CONTAINER=fhir-audit-logs

# NHS PDS (Patient Demographics Service) sandbox
# Register at https://digital.nhs.uk/developer/api-catalogue/personal-demographics-service-fhir
# to obtain an API key and sandbox base URL.
NHS_PDS_FHIR_URL=https://sandbox.api.service.nhs.uk/personal-demographics/FHIR/R4
NHS_API_KEY=<your-nhs-api-key>
